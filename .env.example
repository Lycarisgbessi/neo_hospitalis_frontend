# ── Fournisseur IA principal : GLM via OpenRouter (recommandé) ────────────────
# Créez une clé sur https://openrouter.ai/keys puis :
#   cp .env.example .env
# NOTE (sécurité) : cette clé est exposée côté client dans le bundle.
# Ne réutilisez jamais une clé de production ici ; créez une clé dédiée à la démo
# et restreignez-la (quota) dans votre tableau de bord OpenRouter.
VITE_OPENROUTER_API_KEY="VOTRE_CLE_OPENROUTER"

# Modèle principal (GLM). Exemples :
#   z-ai/glm-4.6             (défaut — raisonnement, équilibré)
#   z-ai/glm-5.3-flash       (plus rapide)
VITE_AI_MODEL="z-ai/glm-4.6"

# Modèle de repli AUTOMATIQUE si le principal échoue (crédits épuisés 402,
# rate-limit 429...). Le modèle ci-dessous est gratuit et validé pour la
# structuration médicale en français — la démo reste fonctionnelle sans crédits.
VITE_AI_FALLBACK_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# ── Fournisseur IA de secours (optionnel) : Google Gemini ─────────────────────
# Utilisé uniquement si VITE_OPENROUTER_API_KEY est absente.
VITE_GEMINI_API_KEY="VOTRE_CLE_GEMINI"
